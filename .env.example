# Supabase 프로젝트 설정 → Project Settings → API 에서 복사
# 이 두 값은 앱(클라이언트)에 노출되어도 안전한 공개 키입니다.
# (실제 보안은 Supabase RLS 정책이 담당합니다. supabase/schema.sql 참고)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# (선택) 목업 시세 강제 사용 — 웹 미리보기/오프라인 데모용. 1이면 야후 대신 가짜 시세.
# EXPO_PUBLIC_USE_MOCK=1

# (선택) 웹에서 종목검색/시세를 쓰려면 CORS 프록시 필요 (폰에서는 불필요).
# ?url= 형태 프록시면 자동 인코딩해서 붙입니다.
# EXPO_PUBLIC_YF_PROXY=https://your-cors-proxy.example/?url=
